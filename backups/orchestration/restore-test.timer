[Unit]
Description=Monthly Restore Tests and Integrity Checks Timer (1st Sunday at 4 AM)
Requires=restore-test.service

[Timer]
# Run monthly on the first Sunday at 4:00 AM
# Day 1..7 constrains to the first week, so combined with Sun this is always the first Sunday
OnCalendar=Sun *-*-1..7 04:00:00
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
