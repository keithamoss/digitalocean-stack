[Unit]
Description=Operational Backup to S3 (secrets, credentials, monitoring state)
After=network-online.target
Wants=network-online.target
OnFailure=backup-failure-alert@operational-backup.service

[Service]
Type=oneshot
# Run as root to simplify backup-domain permissions
User=root
Group=root
WorkingDirectory=@STACK_DIR@/backups/configs

# Run backup via wrapper script
ExecStart=@STACK_DIR@/backups/configs/operational-backup-wrapper.sh

# Timeout after 10 minutes (configs are tiny, should be very fast)
TimeoutStartSec=600

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=operational-backup

# Restart policy
Restart=no

# Resource limits
CPUQuota=50%
MemoryMax=512M

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ReadWritePaths=@STACK_DIR@/logs

[Install]
WantedBy=multi-user.target
