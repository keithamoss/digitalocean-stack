[Unit]
Description=Docker Logs Export Timer
Requires=docker-logs-export.service

[Timer]
# Run at 00:02 daily, just after midnight
# Export yesterday's logs, then logrotate (00:15) immediately rotates them
OnCalendar=*-*-* 00:02:00
Persistent=true
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
