[Unit]
Description=Foundry VTT Data Backup
After=network-online.target
Wants=network-online.target
OnFailure=backup-failure-alert@foundry-backup.service

[Service]
Type=oneshot
# Run as root to simplify backup-domain permissions
User=root
Group=root
WorkingDirectory=@STACK_DIR@/backups/foundry

# Run backup via wrapper script
ExecStart=@STACK_DIR@/backups/foundry/backup-wrapper.sh

# Timeout after 10 minutes
TimeoutStartSec=600

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=foundry-backup

# Restart policy
Restart=no

# Resource limits
CPUQuota=50%
MemoryMax=2G

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ReadWritePaths=@STACK_DIR@/logs/backups/foundry @STACK_DIR@/foundry/data
