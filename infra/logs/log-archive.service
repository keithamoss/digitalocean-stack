[Unit]
Description=Log Archive
OnFailure=backup-failure-alert@log-archive.service

[Service]
Type=oneshot
# Run as root — required to read/write log files created by root-owned backup services
User=root
Group=root
WorkingDirectory=@STACK_DIR@/infra/logs

ExecStart=@STACK_DIR@/infra/logs/log-archive.sh

# Timeout after 5 minutes (should complete in seconds)
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=log-archive

# Restart policy
Restart=no

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STACK_DIR@/logs/backups @STACK_DIR@/logs/restore
