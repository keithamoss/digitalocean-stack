[Unit]
Description=Backup Log Archive
OnFailure=backup-failure-alert@backups-log-archive.service

[Service]
Type=oneshot
# Run as root — required to read/write log files created by root-owned backup services
User=root
Group=root
WorkingDirectory=@STACK_DIR@/infra/backups

ExecStart=@STACK_DIR@/infra/backups/backups-log-archive.sh

# Timeout after 5 minutes (should complete in seconds)
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backups-log-archive

# Restart policy
Restart=no

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STACK_DIR@/logs/backups
