# Docker container logs exported daily to static filenames
# Export runs at 00:02 (just after midnight), writes yesterday's logs
# Logrotate runs at 00:15, immediately rotating the just-exported logs
# Rotate exported logs with 60-day retention
# ONLY for services without file-based logging:
#   - Redis
#   - memcached
#   - rq_dashboard  
#   - cloudflared tunnels
#   - Foundry
#
# Each service has its own block with olddir to move rotated logs into subdirectories

/opt/digitalocean-stack/logs/docker/redis.log {
    daily
    rotate 60
    maxage 60
    missingok
    notifempty
    nocreate
    compress
    delaycompress
    dateext
    dateyesterday
    dateformat -%Y.%m.%d
    extension .log
    olddir redis
    createolddir 755 root root
}

