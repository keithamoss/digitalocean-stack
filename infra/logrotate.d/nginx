# Log rotation for nginx running in digitalocean-stack
# Logs located at /opt/digitalocean-stack/logs/nginx/access/ and /opt/digitalocean-stack/logs/nginx/error/
# Format: access-YYYY.MM.DD.log, error-YYYY.MM.DD.log
# Note: Use specific filenames to avoid rotating already-rotated files
# Rotated logs are moved to archive/ subdirectories

/opt/digitalocean-stack/logs/nginx/access/access.log /opt/digitalocean-stack/logs/nginx/error/error.log {
    su root root
    daily
    missingok
    rotate 60
    compress
    delaycompress
    notifempty
    dateext
    dateyesterday
    dateformat -%Y.%m.%d
    extension .log
    olddir archive
    createolddir 755 root root
    sharedscripts
    postrotate
        # Signal nginx master directly to reopen log files without creating top-level signal-process notices
        docker exec nginx-nginx-1 sh -c 'kill -USR1 "$(cat /var/run/nginx.pid)"' 2>/dev/null || true
    endscript
}
