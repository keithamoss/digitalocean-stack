# Log rotation for demsausage application logs
# Logs located at /opt/digitalocean-stack/logs/demsausage-staging/
# Format: [service]-YYYY.MM.DD.log

/opt/digitalocean-stack/logs/demsausage-staging/gunicorn/*.log {
    daily
    missingok
    rotate 60
    compress
    delaycompress
    notifempty
    copytruncate
    dateext
    dateformat -%Y.%m.%d
    extension .log
}

