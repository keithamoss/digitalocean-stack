# Log rotation for demsausage application logs
# Logs located at /opt/digitalocean-stack/logs/demsausage-staging/
# Format: [service]-YYYY.MM.DD.log
# Note: Use specific filenames to avoid rotating already-rotated files
# Rotated logs are moved to archive/ subdirectories

/opt/digitalocean-stack/logs/demsausage-staging/gunicorn/gunicorn_a.log /opt/digitalocean-stack/logs/demsausage-staging/gunicorn/gunicorn_b.log {
    daily
    missingok
    rotate 60
    compress
    delaycompress
    notifempty
    copytruncate
    dateext
    dateyesterday
    dateformat -%Y.%m.%d
    extension .log
    olddir archive
    createolddir 755 root root
}

